import wollok.game.*
import src.cellPosition.*
import src.menu.menuManager.*
import src.menu.editMenu.*
import src.menu.placeMenu.*
import src.tools.toolsManager.*
import src.tools.userTools.*
import src.machines.machineManager.*
import src.directions.*

describe "tests de menuManager" {

  // lo que hay dibujado en la primera posición de la zona interactiva (el primer ítem de place)
  method firstSlotVisuals() = game.getObjectsIn(new CellPosition(x = 22, y = 1))

  test "al arrancar se muestra el panel de place" {
    menuManager.setUp()
    assert.that(game.hasVisual(overlay))
    assert.notThat(game.hasVisual(infoText))
  }

  test "con edit se muestra el texto Info y se saca el panel de place" {
    menuManager.setUp()
    toolsManager.select(edit)
    assert.that(game.hasVisual(infoText))
    assert.notThat(game.hasVisual(overlay))
    assert.that(self.firstSlotVisuals().isEmpty())
  }

  test "volver a place saca el texto Info y vuelve a dibujar las máquinas" {
    menuManager.setUp()
    toolsManager.select(edit)
    toolsManager.select(place)
    assert.notThat(game.hasVisual(infoText))
    assert.that(game.hasVisual(overlay))
    assert.equals(1, self.firstSlotVisuals().size())
  }

  test "con delete o rotate la zona interactiva queda vacía" {
    menuManager.setUp()
    toolsManager.select(delete)
    assert.notThat(game.hasVisual(infoText))
    assert.notThat(game.hasVisual(overlay))
    toolsManager.select(rotate)
    assert.notThat(game.hasVisual(infoText))
    assert.notThat(game.hasVisual(overlay))
  }

  test "cambiar la dirección actualiza las imágenes del panel activo" {
    menuManager.setUp()
    toolsManager.currentDirection(up)
    assert.equals("machines/Belt/up.png", self.firstSlotVisuals().first().image())
  }

  test "cambiar de página con el panel de edit no dibuja máquinas" {
    menuManager.setUp()
    toolsManager.select(edit)
    menuManager.nextPage()
    assert.that(self.firstSlotVisuals().isEmpty())
  }

  test "los ítems del panel de place se dibujan en x 22 y en y 1, 4, 7 y 10" {
    menuManager.setUp()
    const sizes = [1, 4, 7, 10].map({ y => game.getObjectsIn(new CellPosition(x = 22, y = y)).size() })
    assert.equals([1, 1, 1, 1], sizes)
  }

  test "el overlay se ubica al lado del slot elegido" {
    menuManager.setUp()
    assert.equals(new CellPosition(x = 21, y = 0), overlay.position())
    toolsManager.onClick(game.at(22, 8))
    assert.equals(new CellPosition(x = 21, y = 6), overlay.position())
  }

  test "cambiar de página con el panel de place muestra las máquinas de la otra página" {
    menuManager.setUp()
    menuManager.nextPage()
    assert.equals("machines/Fryer/right.png", self.firstSlotVisuals().first().image())
    assert.notThat(game.hasVisual(overlay))
  }

  test "un click en la zona interactiva con place elige la máquina del slot" {
    menuManager.setUp()
    toolsManager.onClick(game.at(22, 8))
    assert.equals("Oven", machineManager.selectedName())
    assert.that(game.hasVisual(overlay))
  }

  test "un click en la zona interactiva con edit no cambia la máquina elegida" {
    menuManager.setUp()
    toolsManager.select(edit)
    toolsManager.onClick(game.at(22, 8))
    assert.equals("Belt", machineManager.selectedName())
  }
}
