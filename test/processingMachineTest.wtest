import wollok.game.*
import src.machines.machineClasses.*
import src.machines.types.cuttingMachine.*
import src.machines.types.oven.*
import src.tools.toolsManager.*
import src.directions.*
import src.board.*
import src.simulation.simulationEngine.*
import src.simulation.animationEngine.*
import src.food.foodClasses.*
import src.food.foodTypes.*

// Un ingrediente que tarda 30 pasos (más que los 15 que antes permitía la agenda)
object slowIngredient inherits IngredientKind {
override method image() = "no_texture.png"
override method processTime() = 30
override method initialize() {
    self.turnsInto(cutting, cutPotato)
    self.turnsInto(cooking, cookedMeat)
}
}

// Una máquina que procesa sin definir workImages: se queda quieta, pero respeta el tiempo
class DummyProcessor inherits ProcessingMachine {
override method name() = "DummyProcessor"
override method foodProcess() = cutting
}

// Recibe lo que le entrega la máquina de atrás, sin animarlo
class ReceivingSink inherits Machine {
const property received = []

override method name() = "ReceivingSink"
override method canReceive(item) = true
override method onReceive(item) {
    received.add(item)
}
}

describe "tests de TimedAnimation" {

const images17 = (0..16).map({ i => "i" + i })

test "dura exactamente la cantidad de pasos pedida" {
    const animation = new TimedAnimation(images = ["a", "b", "c"], steps = 10)
    assert.equals(10, animation.size())
    assert.equals(10, animation.frames().size())
}

test "empieza en la primera imagen" {
    const animation = new TimedAnimation(images = ["a", "b", "c"], steps = 10)
    assert.equals("a", animation.frames().first())
}

test "con mas imagenes que pasos saltea imagenes en una sola vuelta" {
    const animation = new TimedAnimation(images = images17, steps = 4)
    assert.equals(["i0", "i4", "i8", "i12"], animation.frames())
}

test "con el doble de pasos que imagenes hace dos vueltas exactas" {
    const animation = new TimedAnimation(images = images17, steps = 34)
    assert.equals(2, animation.frames().count({ frame => frame == "i16" }))
    assert.equals("i0", animation.frames().first())
    assert.equals("i16", animation.frames().last())
}

test "con menos imagenes que pasos repite las vueltas y termina en la ultima imagen" {
    const animation = new TimedAnimation(images = ["a", "b", "c"], steps = 10)
    assert.equals(["a", "a", "b", "c", "a", "b", "c", "a", "b", "c"], animation.frames())
}

test "con una sola imagen todos los pasos muestran esa imagen" {
    const animation = new TimedAnimation(images = ["solo"], steps = 6)
    assert.equals(6, animation.size())
    assert.that(animation.frames().all({ frame => frame == "solo" }))
}
}

describe "tests de la cortadora: tiempo de procesamiento" {

const cutter = new CuttingMachine()
const cellSteps = animationEngine.pasosPorCelda()

method initialize() {
    toolsManager.currentDirection(right)
    board.push(game.at(7, 5), cutter)
}

method steps(amount) {
    amount.times({ _ => simulationEngine.step() })
}

  // Le entrega un item a la cortadora, como haria la maquina de atras
method feed(item) {
    item.position(cutter.position())
    simulationEngine.addItem(item)
    cutter.receive(item)
}

test "un tomate tarda 4 pasos en cortarse desde que llega" {
    const piece = new Item(kind = tomato)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 3)
    assert.equals(tomato, piece.kind())
    self.steps(1)
    assert.equals(cutTomato, piece.kind())
}

test "una papa tarda 5 pasos, el tiempo por defecto" {
    const piece = new Item(kind = potato)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 4)
    assert.equals(potato, piece.kind())
    self.steps(1)
    assert.equals(cutPotato, piece.kind())
}

test "un ingrediente que tarda mas de 15 pasos se corta igual" {
    const piece = new Item(kind = slowIngredient)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 29)
    assert.equals(slowIngredient, piece.kind())
    self.steps(1)
    assert.equals(cutPotato, piece.kind())
}

test "al empezar a cortar muestra el primer frame de la animacion de corte" {
    simulationEngine.run()
    self.feed(new Item(kind = potato))
    self.steps(cellSteps)
    assert.equals("machines/CuttingMachine/right_cut/0.png", cutter.image())
}

test "al terminar de cortar vuelve a la imagen quieta" {
    simulationEngine.run()
    self.feed(new Item(kind = potato))
    self.steps(cellSteps + 5)
    assert.equals(cutter.staticImage(), cutter.image())
}

test "al apagar la simulacion a mitad del corte no procesa nada ni da error" {
    const piece = new Item(kind = potato)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 2)
    simulationEngine.stop()
    self.steps(20)
    assert.that(cutter.heldItems().isEmpty())
    assert.notThat(cutter.animando())
    assert.equals(potato, piece.kind())
}
}

describe "tests del horno: tiempo de procesamiento" {

const oven = new Oven()
const cellSteps = animationEngine.pasosPorCelda()

method initialize() {
    toolsManager.currentDirection(right)
    board.push(game.at(7, 5), oven)
}

method steps(amount) {
    amount.times({ _ => simulationEngine.step() })
}

  // Le entrega un item al horno, como haria la maquina de atras
method feed(item) {
    item.position(oven.position())
    simulationEngine.addItem(item)
    oven.receive(item)
}

test "acepta carne cruda pero no tomate" {
    assert.that(oven.canReceive(new Item(kind = meat)))
    assert.notThat(oven.canReceive(new Item(kind = tomato)))
}

test "la carne tarda 8 pasos en cocinarse desde que llega" {
    const piece = new Item(kind = meat)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 7)
    assert.equals(meat, piece.kind())
    self.steps(1)
    assert.equals(cookedMeat, piece.kind())
}

test "un ingrediente que tarda mas de 15 pasos se cocina igual" {
    const piece = new Item(kind = slowIngredient)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 29)
    assert.equals(slowIngredient, piece.kind())
    self.steps(1)
    assert.equals(cookedMeat, piece.kind())
}

test "vacio se ve quieto" {
    simulationEngine.run()
    self.steps(10)
    assert.equals(oven.staticImage(), oven.image())
}

test "mientras cocina muestra el GIF" {
    simulationEngine.run()
    self.feed(new Item(kind = meat))
    self.steps(cellSteps)
    assert.equals("machines/Oven/right.gif", oven.image())
}

test "al terminar de cocinar vuelve a la imagen quieta" {
    simulationEngine.run()
    self.feed(new Item(kind = meat))
    self.steps(cellSteps + 8)
    assert.equals(oven.staticImage(), oven.image())
}

test "al apagar la simulacion a mitad de la coccion no procesa nada ni da error" {
    const piece = new Item(kind = meat)
    simulationEngine.run()
    self.feed(piece)
    self.steps(cellSteps + 3)
    simulationEngine.stop()
    self.steps(20)
    assert.that(oven.heldItems().isEmpty())
    assert.equals(oven.staticImage(), oven.image())
    assert.equals(meat, piece.kind())
}
}

describe "tests de una ProcessingMachine sin workImages" {

const processor = new DummyProcessor()
const sink = new ReceivingSink()
const cellSteps = animationEngine.pasosPorCelda()

method initialize() {
    toolsManager.currentDirection(right)
    board.push(game.at(9, 5), processor)
    board.push(game.at(10, 5), sink)
}

method steps(amount) {
    amount.times({ _ => simulationEngine.step() })
}

method feed(item) {
    item.position(processor.position())
    simulationEngine.addItem(item)
    processor.receive(item)
}

test "acepta lo que puede procesar y rechaza el resto" {
    assert.that(processor.canReceive(new Item(kind = potato)))
    assert.notThat(processor.canReceive(new Item(kind = cutPotato)))
}

test "respeta el tiempo: no entrega antes de tiempo" {
    simulationEngine.run()
    self.feed(new Item(kind = potato))
    self.steps(cellSteps + 4)
    assert.that(sink.received().isEmpty())
}

test "entrega el item procesado cuando termina el tiempo" {
    simulationEngine.run()
    self.feed(new Item(kind = potato))
    self.steps(cellSteps + 5)
    assert.equals(1, sink.received().size())
    assert.equals(cutPotato, sink.received().first().kind())
}
}