import wollok.game.*
import src.cellPosition.*
import src.board.*
import src.directions.*
import src.machines.settings.*
import src.machines.machineClasses.*
import src.machines.types.belt.*
import src.machines.types.dispenser.*
import src.machines.types.automaticArm.*
import src.menu.menuManager.*
import src.menu.editMenu.*
import src.tools.toolsManager.*
import src.tools.userTools.*
import src.food.foodClasses.*
import src.food.foodTypes.*

describe "tests de los settings de las maquinas" {

  const dispenser = new Dispenser()

  test "una maquina sin settings no tiene ninguno y no consume energia" {
    const belt = new Belt()
    assert.that(belt.settings().isEmpty())
    assert.equals(0, belt.energyConsumption())
  }

  test "el dispenser acepta ingrediente y velocidad, los dos de produccion" {
    assert.equals(2, dispenser.settings().size())
    assert.that(dispenser.settings().all({ setting => setting.category() == production }))
  }

  test "el brazo acepta la salida, de movimiento" {
    const arm = new AutomaticArm()
    assert.equals([movement], arm.settings().map({ setting => setting.category() }))
  }

  test "el dispenser larga papa por defecto" {
    assert.equals(potato, dispenser.product())
  }

  test "elegir una opcion cambia el valor del setting" {
    const product = dispenser.settings().first()
    const lettuceOption = product.options().find({ option => option.value() == lettuce })
    product.select(lettuceOption)
    assert.equals(lettuce, dispenser.product())
  }

  test "las opciones del ingrediente se dibujan con la imagen del ingrediente" {
    const product = dispenser.settings().first()
    assert.that(product.options().all({ option => option.hasImage() && option.image() == option.value().image() }))
  }

  test "solo esta elegida la opcion del valor actual" {
    const product = dispenser.settings().first()
    const selected = product.options().filter({ option => product.isSelected(option) })
    assert.equals([potato], selected.map({ option => option.value() }))
  }

  test "las opciones de velocidad se dibujan con texto" {
    const speed = dispenser.settings().last()
    assert.notThat(speed.options().any({ option => option.hasImage() }))
  }

  test "a velocidad normal el dispenser tarda 5 segundos" {
    assert.equals(5000, dispenser.intervalMs())
  }

  test "a velocidad rapida tarda menos y a lenta mas" {
    const speed = dispenser.settings().last()
    speed.value(2)
    assert.equals(2500, dispenser.intervalMs())
    speed.value(0.5)
    assert.equals(10000, dispenser.intervalMs())
  }

  test "la energia que consume suma la de la opcion de velocidad elegida" {
    const speed = dispenser.settings().last()
    speed.value(0.5)
    const slow = dispenser.energyConsumption()
    speed.value(2)
    assert.that(dispenser.energyConsumption() > slow)
  }

  test "un valor que no es una de las opciones no suma energia" {
    dispenser.product(cutBun)
    assert.equals(0, dispenser.settings().first().energyCost())
  }

  test "la configuracion sobrevive a apagar la simulacion" {
    dispenser.product(tomato)
    dispenser.reset()
    assert.equals(tomato, dispenser.product())
  }

  test "cada maquina tiene su propia configuracion" {
    const other = new Dispenser()
    dispenser.product(tomato)
    assert.equals(potato, other.product())
  }

  test "recto entrega del lado contrario al de entrada" {
    assert.equals(right, straightOut.sideFor(left))
    assert.equals(up, straightOut.sideFor(down))
  }

  test "izquierda y derecha son las del recorrido del item" {
    // entra por la izquierda, viaja hacia la derecha: su izquierda es arriba y su derecha, abajo
    assert.equals(up, leftOut.sideFor(left))
    assert.equals(down, rightOut.sideFor(left))
    // entra por arriba, viaja hacia abajo: su izquierda es la derecha de la pantalla
    assert.equals(right, leftOut.sideFor(up))
    assert.equals(left, rightOut.sideFor(up))
  }

  test "el brazo entrega recto por defecto" {
    assert.equals(right, new AutomaticArm().outputSide())
  }
}

// El panel de la herramienta edit. La zona interactiva ocupa x 21 a 24; arriba de todo (y 14)
// va el título de la categoría, abajo el nombre del setting y después sus opciones, de a 4 por fila.
describe "tests del panel de edit" {

  const dispenser = new Dispenser()
  const arm = new AutomaticArm()

  method initialize() {
    menuManager.setUp()
    board.push(game.at(8, 8), dispenser)
    board.push(game.at(8, 4), arm)
    toolsManager.select(edit)
  }

  // un click en una celda de la zona interactiva
  method clickPanel(x, y) {
    toolsManager.onClick(game.at(x, y))
  }

  method panelVisuals() = (21..24).flatMap({ x => (0..14).flatMap({ y => game.getObjectsIn(new CellPosition(x = x, y = y)) }) })

  method markers() = self.panelVisuals().filter({ visual => visual.className().endsWith("OptionMarker") })

  method texts() = self.panelVisuals().filter({ visual => visual.className().endsWith("MenuText") })

  test "sin maquina elegida no muestra nada" {
    assert.that(game.allVisuals().filter({ visual => menuManager.inInteractiveMenu(visual.position()) }).isEmpty())
  }

  test "elegir el dispenser muestra los titulos, los nombres y una marca por setting" {
    toolsManager.onClick(game.at(8, 8))
    assert.equals(2, self.markers().size())
    assert.equals("PRODUCCION", game.getObjectsIn(new CellPosition(x = 21, y = 14)).first().text())
    assert.equals("Ingrediente", game.getObjectsIn(new CellPosition(x = 21, y = 13)).first().text())
    assert.equals("Velocidad", game.getObjectsIn(new CellPosition(x = 21, y = 10)).first().text())
  }

  test "la categoria se muestra una sola vez aunque tenga dos settings" {
    toolsManager.onClick(game.at(8, 8))
    const titles = self.texts().filter({ text => text.text() == "PRODUCCION" })
    assert.equals(1, titles.size())
  }

  test "clickear un ingrediente se lo aplica al dispenser" {
    toolsManager.onClick(game.at(8, 8))
    self.clickPanel(21, 12)
    assert.equals(lettuce, dispenser.product())
  }

  test "el ingrediente que no entra en la primera fila va abajo" {
    toolsManager.onClick(game.at(8, 8))
    self.clickPanel(21, 11)
    assert.equals(tomato, dispenser.product())
  }

  test "clickear una velocidad se la aplica al dispenser" {
    toolsManager.onClick(game.at(8, 8))
    self.clickPanel(23, 9)
    assert.equals(2, dispenser.settings().last().value())
  }

  test "la marca se mueve a la opcion clickeada y sigue habiendo una por setting" {
    toolsManager.onClick(game.at(8, 8))
    self.clickPanel(22, 12)
    assert.equals(2, self.markers().size())
    assert.that(self.markers().any({ marker => marker.position() == new CellPosition(x = 22, y = 12) }))
  }

  test "clickear en un lugar sin opcion no cambia nada" {
    toolsManager.onClick(game.at(8, 8))
    self.clickPanel(24, 12)
    self.clickPanel(22, 1)
    assert.equals(potato, dispenser.product())
  }

  test "el brazo muestra su unico setting, de movimiento" {
    toolsManager.onClick(game.at(8, 4))
    assert.equals("MOVIMIENTO", game.getObjectsIn(new CellPosition(x = 21, y = 14)).first().text())
    assert.equals(1, self.markers().size())
  }

  test "clickear izquierda en el brazo cambia hacia donde entrega" {
    toolsManager.onClick(game.at(8, 4))
    self.clickPanel(22, 12)
    assert.equals(up, arm.outputSide())
  }

  test "elegir otra maquina cambia lo que se muestra" {
    toolsManager.onClick(game.at(8, 8))
    toolsManager.onClick(game.at(8, 4))
    assert.equals(1, self.markers().size())
  }

  test "clickear una celda vacia del tablero saca lo que se mostraba" {
    toolsManager.onClick(game.at(8, 8))
    toolsManager.onClick(game.at(15, 3))
    assert.equals(0, self.markers().size())
  }
}
