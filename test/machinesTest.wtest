import src.machines.types.automaticArm.*
import src.machines.types.belt.*
import src.machines.types.dispenser.*
import src.machines.types.assembler.*
import src.machines.types.oven.*
import src.machines.types.cuttingMachine.*
import src.machines.types.fryer.*
import src.tools.toolsManager.*
import src.directions.*
import wollok.game.*

describe "tests de Machine" {

  test "una Belt se llama Belt" {
    assert.equals("Belt", new Belt().name())
  }

  test "una Oven se llama Oven" {
    assert.equals("Oven", new Oven().name())
  }

  test "una Fryer se llama Fryer" {
    assert.equals("Fryer", new Fryer().name())
  }

  test "una CuttingMachine se llama CuttingMachine" {
    assert.equals("CuttingMachine", new CuttingMachine().name())
  }

  test "una Assembler se llama Assembler" {
    assert.equals("Assembler", new Assembler().name())
  }

  test "una Dispenser se llama Dispenser" {
    assert.equals("Dispenser", new Dispenser().name())
  }

  test "una maquina nace con la direccion actual del toolsManager" {
    toolsManager.currentDirection(up)
    const oven = new Oven()
    assert.equals("machines/Oven/up_game.png", oven.image())
  }

  // Wollok inicializa los atributos al leerlos por primera vez: la máquina tiene que
  // quedarse con la dirección que había al crearla, aunque después cambie
  test "una maquina conserva la direccion con la que se creo aunque despues cambie la actual" {
    toolsManager.currentDirection(up)
    const oven = new Oven()
    toolsManager.currentDirection(left)
    assert.equals("machines/Oven/up_game.png", oven.image())
  }

  test "rotate cambia la direccion de la maquina de right a down" {
    toolsManager.currentDirection(right)
    const belt = new Belt()
    belt.rotate()
    assert.equals("machines/Belt/down_game.png", belt.image())
  }

  test "rotate no afecta a otras maquinas ya creadas" {
    toolsManager.currentDirection(right)
    const belt1 = new Belt()
    const belt2 = new Belt()
    belt1.rotate()
    assert.equals("machines/Belt/down_game.png", belt1.image())
    assert.equals("machines/Belt/right_game.png", belt2.image())
  }

  test "una maquina recien creada se ve quieta" {
    toolsManager.currentDirection(right)
    assert.equals("machines/Belt/right_game.png", new Belt().image())
  }

  test "al prender la simulacion una maquina pasa a la imagen animada" {
    toolsManager.currentDirection(right)
    const belt = new Belt()
    belt.start()
    assert.equals("machines/Belt/right.gif", belt.image())
  }

  // La cortadora es frame a frame: se anima sólo mientras corta (el Dispenser ahora usa GIF)
  test "al prender la simulacion una maquina sin gif sigue quieta" {
    toolsManager.currentDirection(right)
    const cutter = new CuttingMachine()
    cutter.start()
    assert.equals("machines/CuttingMachine/right_game.png", cutter.image())
  }

  test "al prender la simulacion el dispenser pasa a su gif" {
    toolsManager.currentDirection(right)
    const dispenser = new Dispenser()
    dispenser.start()
    assert.equals("machines/Dispenser/right.gif", dispenser.image())
  }

  test "al apagar la simulacion una maquina vuelve a la imagen quieta" {
    toolsManager.currentDirection(right)
    const belt = new Belt()
    belt.start()
    belt.reset()
    assert.equals("machines/Belt/right_game.png", belt.image())
  }

  test "la imagen del menu depende de la direccion elegida" {
    assert.equals("machines/Belt/up_menu.png", new Belt().menuImage(up))
  }

  test "la celda de una maquina comun es su posicion" {
    const belt = new Belt()
    belt.position(game.at(7, 4))
    assert.equals(game.at(7, 4), belt.cell())
  }
}
