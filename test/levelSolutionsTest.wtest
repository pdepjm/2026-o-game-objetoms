import wollok.game.*
import src.board.*
import src.directions.*
import src.cellPosition.*
import src.machines.types.belt.*
import src.machines.types.processing.*
import src.machines.types.arms.*
import src.machines.types.assembler.*
import src.machines.types.deliverySlot.*
import src.menu.screenManager.*
import src.menu.screens.*
import src.menu.hud.hud.*
import src.menu.hud.rightPanel.*
import src.cellPosition.*
import src.simulation.simulationEngine.*
import src.food.foodTypes.*
import src.food.recipes.*
import src.levels.levelsTypes.*
import src.levels.levelManager.*

// Una forma de ganar cada nivel, armada máquina por máquina: si un cambio (en los niveles, las máquinas o
// las recetas) hace que un nivel no se pueda ganar, falla acá. No es la única forma de ganarlos.

describe "tests de que los niveles se pueden ganar" {

  method initialize() {
    playingScreen.show()
    deliveryPoints.setUp()
  }

  // Coloca la máquina como lo haría el jugador: tiene que poder construir ahí (las zonas del nivel)
  method put(x, y, machine) {
    const pos = new CellPosition(x = x, y = y)
    if (!board.canBuild(pos, machine)) self.error("No se puede construir en (" + x + ", " + y + ")")
    board.push(pos, machine)
    return machine
  }

  // Cintas en esa fila, de x0 a x1, mirando hacia ese lado
  method beltsRow(y, x0, x1, direction) {
    (x0 .. x1).forEach({ x => self.put(x, y, new Belt(direction = direction)) })
  }

  // Cintas en esa columna, de y0 a y1, mirando hacia ese lado
  method beltsColumn(x, y0, y1, direction) {
    (y0 .. y1).forEach({ y => self.put(x, y, new Belt(direction = direction)) })
  }

  method dispenserAt(x, y) = board.machineAt(new CellPosition(x = x, y = y))

  method assembler(x, y, recipe) {
    const assembler = self.put(x, y, new Assembler(direction = up))
    assembler.settings().first().value(recipe)
    return assembler
  }

  // La salida de un ensamblador en (12, 7) hasta el primer platito (13, 11): sube por la columna 12
  // hasta la fila de arriba, y sube al platito por la 13
  method exitToFirstPlate() {
    self.put(12, 9, new Belt(direction = up))
    self.put(12, 10, new Belt(direction = right))
    self.put(13, 10, new Belt(direction = up))
  }

  // Prende la simulación y la deja correr hasta ganar (o hasta cansarse)
  method runUntilWon() {
    levelManager.toggleSimulation()
    (1 .. 9000).forEach({ _ => if (simulationEngine.running()) simulationEngine.step() })
    return levelManager.completed()
  }

  test "nivel 1: dos lineas de corte que llegan al ensamblador por abajo y por la izquierda" {
    levelManager.load(level1)
    // lechuga: fila 8, entra por la izquierda del ensamblador (10, 7)
    self.put(6, 8, new Belt(direction = right))
    self.put(7, 8, new CuttingMachine(direction = right))
    self.beltsRow(8, 8, 9, right)
    // tomate: fila 3, sube por la columna 10 y entra por abajo
    self.put(6, 3, new Belt(direction = right))
    self.put(7, 3, new CuttingMachine(direction = right))
    self.beltsRow(3, 8, 9, right)
    self.beltsColumn(10, 3, 6, up)
    self.assembler(10, 7, saladRecipe)
    // salida: sube por la columna 10 y va por la fila de arriba hasta el platito
    self.put(10, 9, new Belt(direction = up))
    self.beltsRow(10, 10, 12, right)
    self.put(13, 10, new Belt(direction = up))
    assert.that(self.runUntilWon())
  }

  test "nivel 2: cuatro lineas, una por ingrediente, cada una por su lado del ensamblador" {
    levelManager.load(level2)
    self.dispenserAt(5, 8).product(bun)
    self.dispenserAt(5, 7).product(lettuce)
    self.dispenserAt(5, 4).product(tomato)
    self.dispenserAt(5, 2).product(meat)
    // pan (fila 8) y lechuga (fila 7): entran por la izquierda del ensamblador (12, 7)
    [8, 7].forEach({ y =>
      self.put(6, y, new Belt(direction = right))
      self.put(7, y, new CuttingMachine(direction = right))
      self.beltsRow(y, 8, 11, right)
    })
    // tomate: fila 4, sube por la columna 12 y entra por abajo
    self.put(6, 4, new Belt(direction = right))
    self.put(7, 4, new CuttingMachine(direction = right))
    self.beltsRow(4, 8, 11, right)
    self.beltsColumn(12, 4, 6, up)
    // carne: fila 2, al horno, sube por la columna 13 y entra por abajo
    self.put(6, 2, new Belt(direction = right))
    self.put(7, 2, new Oven(direction = right))
    self.beltsRow(2, 8, 12, right)
    self.beltsColumn(13, 2, 6, up)
    self.assembler(12, 7, burgerRecipe)
    self.exitToFirstPlate()
    assert.that(self.runUntilWon())
  }

  test "nivel 3: el tablero esta limitado" {
    levelManager.load(level3)
    assert.notThat(board.isBuildable(game.at(16, 9)))
    assert.notThat(board.isBuildable(game.at(8, 10)))
  }

  test "nivel 3: la pizza y el desayuno, cada uno con su ensamblador y su platito" {
    levelManager.load(level3)
    self.dispenserAt(5, 9).product(pizzaDough)
    self.dispenserAt(5, 8).product(cheese)
    self.dispenserAt(5, 7).product(salami)
    self.dispenserAt(5, 4).product(egg)
    self.dispenserAt(5, 2).product(bacon)
    // PIZZA, ensamblador en (12, 8): masa al horno (fila 9) y queso cortado (fila 8) por la izquierda,
    // salame cortado (fila 7) por abajo
    self.put(6, 9, new Belt(direction = right))
    self.put(7, 9, new Oven(direction = right))
    self.beltsRow(9, 8, 11, right)
    [8, 7].forEach({ y =>
      self.put(6, y, new Belt(direction = right))
      self.put(7, y, new CuttingMachine(direction = right))
      self.beltsRow(y, 8, 11, right)
    })
    self.put(12, 7, new Belt(direction = up))
    self.assembler(12, 8, pizzaPepperoniRecipe)
    // su salida: por la fila de arriba hasta el primer platito (13, 11)
    self.put(12, 10, new Belt(direction = right))
    self.put(13, 10, new Belt(direction = up))
    // DESAYUNO, ensamblador en (14, 3): el huevo (fila 4) va a la freidora con un brazo común, y lo saca
    // uno inteligente (que sólo toma lo ya procesado, así que espera a que se fría); entra por la izquierda
    self.put(6, 4, new Belt(direction = right))
    self.put(7, 4, new AutomaticArm(direction = left))
    self.put(8, 4, new Fryer(direction = right))
    const smartArm = new SmartRoboticArm(direction = left)
    smartArm.settings().first().value([eggFryed])
    self.put(9, 4, smartArm)
    self.beltsRow(4, 10, 13, right)
    // la panceta (fila 2) al horno, y entra por abajo
    self.put(6, 2, new Belt(direction = right))
    self.put(7, 2, new Oven(direction = right))
    self.beltsRow(2, 8, 13, right)
    self.put(14, 2, new Belt(direction = up))
    self.assembler(14, 3, breakfastRecipe)
    // la salida: sube por la columna 14 hasta el segundo platito (14, 11)
    self.beltsColumn(14, 5, 10, up)
    assert.that(self.runUntilWon())
  }

  // Nivel 4, armado compacto: el ensamblador en (9, 7) y cuatro lineas cortas que llegan a el. Pan (fila 8) y lechuga
  // (fila 7) entran por la izquierda; tomate (fila 5) y carne (fila 4) suben y entran por abajo.
  method buildLevel4() {
    levelManager.load(level4)
    self.dispenserAt(5, 8).product(bun)
    self.dispenserAt(5, 7).product(lettuce)
    self.dispenserAt(5, 5).product(tomato)
    self.dispenserAt(5, 4).product(meat)
    [8, 7, 5].forEach({ y =>
      self.put(6, y, new Belt(direction = right))
      self.put(7, y, new CuttingMachine(direction = right))
      self.put(8, y, new Belt(direction = right))
    })
    self.beltsColumn(9, 5, 6, up)
    self.put(6, 4, new Belt(direction = right))
    self.put(7, 4, new Oven(direction = right))
    self.beltsRow(4, 8, 9, right)
    self.beltsColumn(10, 4, 6, up)
    self.assembler(9, 7, burgerRecipe)
    self.put(9, 9, new Belt(direction = up))
    self.beltsRow(10, 9, 12, right)
    self.put(13, 10, new Belt(direction = up))
  }

  test "nivel 4: armado compacto pero a velocidad normal, se pasa del limite" {
    self.buildLevel4()
    assert.that(board.totalEnergy() > level4.energyLimit().max())
    levelManager.toggleSimulation()
    assert.notThat(simulationEngine.running())
  }

  // Baja a x0.5 la velocidad de todas las máquinas que tienen ese setting (dispensers, cortadoras, horno, ensamblador)
  method slowDownEverything() {
    board.machines().forEach({ machine =>
      machine.settings().filter({ setting => setting.name() == "Velocidad" }).forEach({ setting => setting.value(0.5) })
    })
  }

  test "nivel 4: armado compacto y con todo a x0.5 entra en el limite y se gana" {
    self.buildLevel4()
    self.slowDownEverything()
    assert.that(level4.energyLimit().allows(board.totalEnergy()))
    assert.that(self.runUntilWon())
  }
}
