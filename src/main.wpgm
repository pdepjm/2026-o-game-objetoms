import wollok.game.*
import input.userController.*
import menu.startMenu.*
import simulation.simulationEngine.*
import sound.musicManager.*

program BuffetAlbertEinstein {
	game.title("Buffet Albert Einstein")
	game.height(16)
	game.width(25)
	game.cellSize(50)
	game.boardGround("background.gif")

	userController.setUp() 
	// La portada. El juego (los menús, los platitos y el primer nivel) se arma al apretar Enter (ver startMenu.start)
	startMenu.show()

	// Engancha el reloj de la simulación (arranca apagada, en modo construcción)
	simulationEngine.start()

	game.schedule(500, {musicManager.playBackground() })

	game.start()
}