import wollok.game.*
import menu.placeMenu.*
import input.userController.*
import simulation.ingredientes.*
import directions.*
import simulation.simulationEngine.*

program BuffetAlbertEinstein {
	game.title("Pepita")
	game.height(16)
	game.width(25)
	game.cellSize(50)

	game.boardGround("fondo.gif")


	userController.setUp()
	placeMenu.renderItems()






	// 5: prende/apaga la simulación. Al apagarla se borran los ingredientes.
	keyboard.num5().onPressDo({ => simulationEngine.toggle() })

	// Engancha el reloj de la simulación (arranca apagada, en modo construcción)
	simulationEngine.start()



	game.start()
}
