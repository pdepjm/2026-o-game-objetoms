import wollok.game.*
import menu.menuManager.*
import input.userController.*
import food.foodClasses.*
import food.foodTypes.*
import directions.*
import simulation.simulationEngine.*
import machines.types.deliverySlot.*
import levels.levelManager.*

program BuffetAlbertEinstein {
	game.title("Pepita")
	game.height(16)
	game.width(25)
	game.cellSize(50)

	game.boardGround("background.gif")


	userController.setUp()
	menuManager.setUp()
	deliveryPoints.setUp()
	// Carga el primer nivel (después de los menús: los usa para mostrar el catálogo y la info)
	levelManager.start()

	// Engancha el reloj de la simulación (arranca apagada, en modo construcción)
	simulationEngine.start()



	game.start()
}
