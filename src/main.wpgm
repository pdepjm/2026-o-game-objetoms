import wollok.game.*
import tablero.*
import maquinas.*

program BuffetAlbertEinstein {
	game.title("Pepita")
	game.height(13)
	game.width(25)
	game.cellSize(50)

	game.boardGround("fondo.png")

	// Delegar Clicks al click Handler
	game.onClickDo({
		pos => clickManager.clickHandler(pos)
	})
	game.onDoubleClickDo({
		pos => clickManager.doubleClickHandler(pos) 
	})

	game.start()
}


object clickManager {
	// Que hay que hacer en caso de que se haga click en una determinada parte de la pantalla
	method clickHandler(pos){
		console.println(pos)
		if (pos.x()> 20){
			// Se hizo click en el menú
			toolManager.chooseTool(pos)

		}else{
			orquestador.colocar(pos, toolManager.selectedTool())
		}
	}

	// Manejador del doble click
	method doubleClickHandler(pos){
		orquestador.quitar(pos) 
	}
}


object toolManager{
	// Tenemos dos motedos.
	// selectedTool va a devolver una nueva instancia de la herramienta seleccionada.
	// chooseTool va a validar el click y va a actualizar selectedTool segun corresponda.

	// herramienta default y aplicar la lambda de la herramietna seleccioanda
	var selectedTool =  {=> new Cinta()}
	method selectedTool() = selectedTool.apply()
	method chooseTool(pos){
		// Este método, depende donde se hizo click, establece la herramienta seleccionada
		// a la clase correspondiente al elemento

		// Guard clause: se hizo click fuera de las columnas de elementos
		if (pos.x()>=25 || pos.x()<=22){
		}

		// se establecen lambdas que instancien las maquinas/herramientas.
		if (pos.y()>=1 && pos.y() <=2){
			selectedTool =  {=> new Cinta()}
		}

		if (pos.y()>=4 && pos.y() <=5){
			selectedTool = {=> new Horno()}
		}
	}
}