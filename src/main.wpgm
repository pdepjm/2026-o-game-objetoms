import wollok.game.*
import menu.place_menu.*
import userController.*

program BuffetAlbertEinstein {
	game.title("Pepita")
	game.height(16)
	game.width(25)
	game.cellSize(50)

	game.boardGround("fondo.gif")


	userController.configurar()
	place_menu.renderItems()
	game.addVisual(overlay)

	game.start()
}
